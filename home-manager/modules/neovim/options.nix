{
  # Show absolute line numbers
  number = true;

  # Show relative line numbers
  relativenumber = true;

  # Number of spaces a <Tab> counts for
  tabstop = 2;

  # Number of spaces a <Tab> counts for while editing
  softtabstop = 2;

  # Always show the tabline, even with only one tab
  showtabline = 2;

  # Use spaces instead of tab characters
  expandtab = true;

  # Enable smart indentation
  smartindent = true;

  # Number of spaces for each level of (auto)indent
  shiftwidth = 2;

  # Indent wrapped lines visually
  breakindent = true;

  # Highlight the current cursor line
  cursorline = true;

  # Keep 8 lines of context above/below the cursor
  scrolloff = 8;

  # Enable mouse support in all modes
  mouse = "a";

  # Set folding method to manual (user-defined)
  foldmethod = "manual";

  # Disable code folding by default
  foldenable = false;

  # Wrap lines at convenient points like spaces
  linebreak = true;

  # Disable spell checking
  spell = false;

  # Disable creation of swap files
  swapfile = false;

  # Timeout for mapped sequences (e.g. keybinds)
  timeoutlen = 300;

  # Enable true color support in the terminal
  termguicolors = true;

  # Don’t show "-- INSERT --" or mode messages
  showmode = false;

  # Open horizontal splits below the current window
  splitbelow = true;

  # Maintain screen view when splitting windows
  splitkeep = "screen";

  # Open vertical splits to the right
  splitright = true;

  # Hide the command line unless needed
  cmdheight = 0;

  # Remove the '~' lines after the end of buffer
  fillchars = {
    eob = " ";
  };
}
